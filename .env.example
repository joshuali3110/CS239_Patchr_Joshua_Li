# Copy this file to .env and fill in your values. .env is gitignored; never commit a real key.

# Model connection: any OpenAI-compatible endpoint. Defaults target the Gemini API.
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model to use. List what your key can access with:
#   curl -s "$MODEL_BASE_URL"models -H "Authorization: Bearer $MODEL_API_KEY" | grep '"id"'
MODEL_ID=

# Your API key. If left empty, Patchr falls back to GEMINI_API_KEY from the environment.
MODEL_API_KEY=

# Client-side throttle (requests per minute) to stay under free-tier limits.
MODEL_RPM=5
